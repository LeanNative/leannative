#!/bin/bash
# The throwaway simulator (an iPhone, or an iPad) a CI step runs on, chosen the same way every time:
#
#   framework/native/ci/simulator pick            the runtime and model a new one gets, as device.json's record
#   framework/native/ci/simulator create <name>   a new one, already booting: prints its UDID
#   framework/native/ci/simulator record <udid>   an existing one's record (a UDID or a name)
#   framework/native/ci/simulator keyboard <udid> a booted one's keyboard made for typing by a test: no
#                                                 autocorrection, prediction or slide to type, and no slide-to-type
#                                                 introduction (on a hosted runner, a fresh keyboard with them took
#                                                 100 s to type three letters); after the first boot, which resets them
#
#   UI_RUNTIME      the iOS runtime, e.g. com.apple.CoreSimulator.SimRuntime.iOS-26-5 (default: the newest that has
#                   UI_DEVICE_TYPE; a device-specific runtime, such as one made for a single new iPhone, may not)
#   UI_DEVICE_TYPE  the model (default iPhone 17 Pro), so screenshots keep their size from run to run: an iPhone,
#                   or an iPad such as "iPad Pro 11-inch (M5)" for a wide window; a named runtime without it,
#                   or no runtime with it, fails
#
# `create` returns once the boot is asked for, not once it is done: the caller waits for it
# (`xcrun simctl bootstatus <udid> -b`) and deletes it when it ends (ui-tests, test-mode-check). Neither is
# started under a build: on a hosted runner the boot is minutes of CPU, and a build beside it slows by as much.
set -euo pipefail
CI="$(cd "$(dirname "$0")" && pwd)"

pick() {
  xcrun simctl list -j runtimes | UI_DEVICE_TYPE="${UI_DEVICE_TYPE:-iPhone 17 Pro}" /usr/bin/python3 -c '
import json, os, sys
runtimes = [r for r in json.load(sys.stdin)["runtimes"] if r.get("isAvailable") and r.get("platform", "iOS") == "iOS"
            and r["identifier"].startswith("com.apple.CoreSimulator.SimRuntime.iOS")]
wanted = os.environ.get("UI_RUNTIME")
if wanted:
    runtimes = [r for r in runtimes if r["identifier"] == wanted]
    if not runtimes: sys.exit("no available runtime " + wanted)
if not runtimes: sys.exit("no available iOS runtime")
version = lambda r: [int(p) for p in r["version"].split(".") if p.isdigit()]
has = lambda r: any(t["name"] == os.environ["UI_DEVICE_TYPE"] for t in r.get("supportedDeviceTypes", []))
# unnamed, the newest runtime that has the model: a newer one without it (iOS 27.1 for a single new iPhone, beside
# 27.0) is passed over; when none has it, the newest, so the error below names the models there are
if not wanted and any(has(r) for r in runtimes):
    runtimes = [r for r in runtimes if has(r)]
runtime = max(runtimes, key=version)
models = [t for t in runtime.get("supportedDeviceTypes", []) if t["name"].startswith(("iPhone", "iPad"))]
if not models: sys.exit("no iPhone or iPad for " + runtime["identifier"])
chosen = next((t for t in models if t["name"] == os.environ["UI_DEVICE_TYPE"]), None)
if chosen is None:
    sys.exit(os.environ["UI_DEVICE_TYPE"] + " is not available on " + runtime["identifier"] + "; set UI_DEVICE_TYPE to one of: "
             + ", ".join(t["name"] for t in models))
print(json.dumps({"name": chosen["name"], "type": chosen["identifier"], "runtime": runtime["identifier"],
                  "os": runtime["name"]}))'
}

case "${1:-}" in
  pick) pick ;;
  create)
    name="${2:?simulator create <name>}"
    device="$(pick)"
    model="$(/usr/bin/python3 -c 'import json, sys; print(json.loads(sys.argv[1])["type"])' "$device")"
    runtime="$(/usr/bin/python3 -c 'import json, sys; print(json.loads(sys.argv[1])["runtime"])' "$device")"
    udid="$(xcrun simctl create "$name" "$model" "$runtime")"
    # detached, its output nowhere: `$(simulator create …)` returns now, and the boot goes on after this step
    nohup xcrun simctl boot "$udid" </dev/null >/dev/null 2>&1 &
    echo "$udid"
    ;;
  record)
    xcrun simctl list -j | /usr/bin/python3 -c '
import json, sys
data = json.load(sys.stdin)
models = {t["identifier"]: t["name"] for t in data["devicetypes"]}
names = {r["identifier"]: r["name"] for r in data["runtimes"]}
for runtime, devices in data["devices"].items():
    for d in devices:
        if sys.argv[1] in (d["udid"], d["name"]):
            kind = d.get("deviceTypeIdentifier")
            print(json.dumps({k: v for k, v in {"name": models.get(kind, d["name"]), "type": kind, "runtime": runtime,
                                                "os": names.get(runtime)}.items() if v}))
            sys.exit()
sys.exit("no simulator " + sys.argv[1])' "${2:?simulator record <udid>}"
    ;;
  keyboard)
    udid="${2:?simulator keyboard <udid>}"
    for key in KeyboardAutocorrection KeyboardPrediction KeyboardContinuousPathEnabled; do
      xcrun simctl spawn "$udid" defaults write com.apple.Preferences "$key" -bool NO
    done
    xcrun simctl spawn "$udid" defaults write com.apple.Preferences DidShowContinuousPathIntroduction -bool YES
    ;;
  *) echo "usage: $CI/simulator pick | create <name> | record <udid> | keyboard <udid>" >&2; exit 2 ;;
esac
