#!/usr/bin/env python3
"""Export one UI-test run's evidence: attributable screenshots, the recording, and a provenance manifest.

  framework/native/ci/export-evidence <run> <out> [--name NAME] [--screenshots DIR] [--video-out PATH]
      [--max-video-bytes N] [--transcode auto|ffmpeg|none] [--app-metadata FILE]
      [--source-revision SHA] [--require-passed]

<run> is a directory framework/native/ci/ui-tests wrote ($UI_OUT): <name>.xcresult, xcodebuild.log,
device.json, run.json, <name>.mp4 (optional) and, when the tests write them, a screenshots directory.
<out> must not exist or be empty. It receives

  screenshots/<name>.png    each screenshot the tests attached, copied from the result bundle
  <video-out>               the recording (default video/<name>.mp4), H.264 ≤ 720 wide at 24 fps when ffmpeg
                            is there and asked for, else copied when it fits --max-video-bytes; none when the
                            recording is truncated (under 1 s, or under half the time the tests ran: the
                            recorder runs for the whole of `xcodebuild test`, so a whole one is never shorter)
  evidence.json             the manifest (schema "leannative.ui-evidence/1"), below

A journeys run (ui-tests with UI_JOURNEY) has one XCTest, LNDriver/testDrive, and <run>/journeys.json, the
journeys' own results: the manifest's "journeys" lists them (name, result, seconds, the screenshots each took,
and a failed one's message), and a run whose test passed while a journey failed is "contradictory".

A run whose journeys the app drove itself (run.json's "driver" is "app", or "lanes": several simulators at once,
some of them perhaps on XCTest, each lane's own directory under lanes/) has no result bundle of its own. Its
results are the journeys' (journeys.json, and run.json's exit status), its screenshots the PNGs the journeys
wrote, each attributed to the first journey that lists it, and its "tests" one entry per journey.

What is checked, and how a run that did not pass is recorded:

* Results come from the result bundle (xcresulttool) and xcodebuild.log, both required. The manifest's
  "result" is "passed" only when every test passed in both and the log ends in ** TEST SUCCEEDED **.
  Otherwise it is "failed" (a test failed), "skipped" (none failed, some skipped), "incomplete" (the log
  has no end, a test started without a result, or no test ran) or "contradictory" (the bundle and the
  log disagree), with "result_reasons". The export itself still succeeds; --require-passed makes a
  non-passing run exit 3 after writing the manifest, for callers that publish only passing runs.
* Each screenshot is a result-bundle attachment, attributed to every test that attached it (the first is
  "test"). A PNG the tests also wrote into the screenshots directory must equal one of those captures
  byte for byte, or the export fails. Originals and copies are hashed (SHA-256).
* The tested revision is run.json's "source.revision", recorded by ui-tests as the tests started. It is
  never this checkout's HEAD. --source-revision must match it; without a recorded one, --source-revision
  is required and is recorded as given ("recorded_by": "export-evidence --source-revision").
* device.json (the simulator ui-tests chose, or the Mac) must agree with the device the result bundle names,
  and run.json's platform with the bundle's: a Mac Catalyst run's bundle names macOS, a simulator run's
  the iOS Simulator, so neither is ever recorded as the other.

Nothing is published: where the output goes is the caller's (a CI artifact, a website). Python 3 stdlib.
"""
import argparse
from datetime import datetime, timezone
import hashlib
import json
import math
import os
from pathlib import Path
import re
import shutil
import struct
import subprocess
import sys
import tempfile

SCHEMA = "leannative.ui-evidence/1"
MANIFEST = "evidence.json"
# a recording is truncated below this many seconds, or below this share of the tests' time
MIN_VIDEO_SECONDS = 1.0
MIN_VIDEO_SHARE = 0.5
# the transcoder's bitrate ceiling: plenty for ≤ 720 wide at 24 fps, and within libx264's range
MAX_BITRATE = 8_000_000
PNG_SIGNATURE = b"\x89PNG\r\n\x1a\n"
NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*")
SHA = re.compile(r"[0-9a-f]{40}")
LOG_STARTED = re.compile(r"^Test Case '-\[(?:[\w.]+\.)?(\w+) (\w+)\]' started", re.M)
LOG_CASE = re.compile(r"^Test Case '-\[(?:[\w.]+\.)?(\w+) (\w+)\]' (passed|failed|skipped) \(([0-9.]+) seconds\)\.", re.M)
LOG_TOTAL = re.compile(r"Executed (\d+) tests?, with (\d+) failures? \(\d+ unexpected\) in ([0-9.]+) ")
RESULTS = {"passed": "passed", "failed": "failed", "skipped": "skipped", "expected failure": "passed"}
# run.json's platform (ui-tests) → the platforms a result bundle names for it
BUNDLE_PLATFORMS = {"iOS Simulator": {"iOS Simulator"}, "Mac Catalyst": {"macOS", "Mac Catalyst"}}


class Failure(Exception):
    """The inputs cannot be exported as evidence (missing, malformed or inconsistent)."""


def digest(path):
    sha = hashlib.sha256()
    with Path(path).open("rb") as source:
        for block in iter(lambda: source.read(1 << 20), b""):
            sha.update(block)
    return sha.hexdigest()


def tree_digest(directory):
    """SHA-256 over every file of a directory (a result bundle): sorted relative paths and their digests."""
    sha = hashlib.sha256()
    root = Path(directory)
    for path in sorted(p for p in root.rglob("*") if p.is_file()):
        sha.update(f"{path.relative_to(root).as_posix()}\0{digest(path)}\n".encode())
    return sha.hexdigest()


def png_size(path):
    with Path(path).open("rb") as image:
        head = image.read(24)
    if len(head) < 24 or not head.startswith(PNG_SIGNATURE) or head[12:16] != b"IHDR":
        raise Failure(f"{Path(path).name}: not a PNG image")
    width, height = struct.unpack(">II", head[16:24])
    if width == 0 or height == 0:
        raise Failure(f"{Path(path).name}: PNG has no pixels")
    return width, height


def read_json(path, what):
    try:
        return json.loads(Path(path).read_text())
    except FileNotFoundError:
        raise Failure(f"missing {what} ({Path(path).name})")
    except ValueError as error:
        raise Failure(f"{what} ({Path(path).name}) is not JSON: {error}")


# -- results --------------------------------------------------------------------------------------------

def xcresulttool(*arguments):
    """`xcrun xcresulttool ...`'s output, or None without it (not macOS, no Xcode) or when it fails."""
    if shutil.which("xcrun") is None:
        return None
    try:
        return subprocess.run(["xcrun", "xcresulttool", *arguments], check=True, text=True, capture_output=True).stdout
    except (subprocess.CalledProcessError, OSError):
        return None


def parse_bundle_results(data):
    """[{name, class, result, bundle_result, seconds}] and the device from `xcresulttool get test-results tests`."""
    cases = []

    def walk(node, suite):
        if node.get("nodeType") == "Test Case":
            identifier = node.get("nodeIdentifier", "")
            raw = str(node.get("result", "")).lower()
            cases.append({"name": node["name"].rstrip("()"),
                          "class": identifier.split("/")[0] if "/" in identifier else suite,
                          "result": RESULTS.get(raw, raw or "unknown"), "bundle_result": node.get("result"),
                          "seconds": round(float(node.get("durationInSeconds", 0)), 3)})
            return
        for child in node.get("children", []):
            walk(child, node.get("name") if node.get("nodeType") == "Test Suite" else suite)

    for node in data.get("testNodes", []):
        walk(node, None)
    device = None
    if data.get("devices"):
        first = data["devices"][0]
        device = {"name": first.get("modelName"), "os_version": first.get("osVersion"), "platform": first.get("platform"),
                  "architecture": first.get("architecture")}
    return {"tests": cases, "device": device}


def parse_log(text):
    cases = [{"name": name, "class": cls, "result": result, "seconds": round(float(seconds), 3)}
             for cls, name, result, seconds in LOG_CASE.findall(text)]
    started = [(cls, name) for cls, name in LOG_STARTED.findall(text)]
    total = LOG_TOTAL.search(text)
    return {"tests": cases, "started": started, "succeeded": "** TEST SUCCEEDED **" in text,
            "failed": "** TEST FAILED **" in text, "total_seconds": float(total.group(3)) if total else None}


def outcome(bundle_tests, log):
    """(result, reasons) of a run, never "passed" unless both sources say every test passed."""
    reasons = []
    logged = sorted((t["class"], t["name"], t["result"]) for t in log["tests"])
    bundled = sorted((t["class"], t["name"], t["result"]) for t in bundle_tests)
    if logged != bundled:
        only_log = sorted(set(logged) - set(bundled))
        only_bundle = sorted(set(bundled) - set(logged))
        reasons.append(f"xcodebuild.log and the result bundle disagree: only in the log {only_log}, "
                       f"only in the bundle {only_bundle}")
    if log["succeeded"] and log["failed"]:
        reasons.append("xcodebuild.log says both TEST SUCCEEDED and TEST FAILED")
    if reasons:
        return "contradictory", reasons
    finished = {(t["class"], t["name"]) for t in log["tests"]}
    if unfinished := [f"{c}.{n}" for c, n in log["started"] if (c, n) not in finished]:
        return "incomplete", [f"started without a result: {', '.join(unfinished)}"]
    if not bundle_tests:
        return "incomplete", ["no test ran"]
    if not (log["succeeded"] or log["failed"]):
        return "incomplete", ["xcodebuild.log has no ** TEST SUCCEEDED ** or ** TEST FAILED ** line"]
    if failed := [t["name"] for t in bundle_tests if t["result"] == "failed"]:
        return "failed", [f"failed: {', '.join(failed)}"]
    if log["failed"]:
        return "failed", ["xcodebuild.log ends in ** TEST FAILED ** (a failure outside the tests: a build, a launch)"]
    if skipped := [t["name"] for t in bundle_tests if t["result"] == "skipped"]:
        return "skipped", [f"skipped: {', '.join(skipped)}"]
    if other := [f"{t['name']} {t['result']}" for t in bundle_tests if t["result"] != "passed"]:
        return "incomplete", [f"results other than passed, failed or skipped: {', '.join(other)}"]
    return "passed", []


# -- screenshots ----------------------------------------------------------------------------------------

def captures(manifest, directory):
    """{screenshot name: [(timestamp, test, file)]} from an exported attachments manifest, earliest first."""
    found = {}
    for entry in manifest:
        test = entry.get("testIdentifier", "").split("/")[-1].rstrip("()")
        for attachment in entry.get("attachments", []):
            human = attachment.get("suggestedHumanReadableName", "")
            match = re.fullmatch(r"(.+?)_\d+_[0-9A-Fa-f-]{36}\.png", human)
            if not match:
                continue
            found.setdefault(match.group(1), []).append(
                (float(attachment.get("timestamp", 0)), test, Path(directory) / attachment["exportedFileName"]))
    for shots in found.values():
        shots.sort(key=lambda shot: shot[0])
    return found


def screenshots(bundle, on_disk, out, scratch):
    if xcresulttool("export", "attachments", "--path", str(bundle), "--output-path", str(scratch)) is None:
        raise Failure(f"the result bundle's attachments could not be exported ({bundle.name}, xcresulttool)")
    manifest_path = Path(scratch) / "manifest.json"
    shots = captures(json.loads(manifest_path.read_text()) if manifest_path.is_file() else [], scratch)
    written = {p.stem: p for p in on_disk.glob("*.png")} if on_disk and on_disk.is_dir() else {}
    if stray := sorted(set(written) - set(shots)):
        raise Failure(f"screenshots on disk that no test attached: {', '.join(stray)}")
    entries = []
    if shots:
        (out / "screenshots").mkdir(parents=True)
    for name in sorted(shots):
        if not NAME.fullmatch(name):
            raise Failure(f"screenshot name {name!r}: letters, digits, '.', '_' and '-' only")
        taken = shots[name]
        hashes = [digest(file) for _, _, file in taken]
        entry = {"name": name, "test": taken[0][1], "tests": sorted({test for _, test, _ in taken}),
                 "captures": len(taken), "original_sha256": hashes[0]}
        if name in written:
            disk = digest(written[name])
            if disk not in hashes:
                raise Failure(f"{name}.png on disk matches none of the result bundle's captures of it")
            entry["on_disk_sha256"] = disk
        target = out / "screenshots" / f"{name}.png"
        shutil.copyfile(taken[0][2], target)
        width, height = png_size(target)
        entry.update(path=f"screenshots/{name}.png", width=width, height=height, bytes=target.stat().st_size,
                     sha256=digest(target))
        if entry["sha256"] != entry["original_sha256"]:
            raise Failure(f"{name}.png changed while copied")
        entries.append(entry)
    return entries


# -- video ----------------------------------------------------------------------------------------------

def mp4_boxes(data, start, end):
    while start + 8 <= end:
        size, kind = struct.unpack(">I4s", data[start:start + 8])
        header = 8
        if size == 1:
            size, header = struct.unpack(">Q", data[start + 8:start + 16])[0], 16
        elif size == 0:
            size = end - start
        if size < header or start + size > end:
            return
        yield kind.decode("latin-1"), start + header, start + size
        start += size


def mp4_info(path):
    """Width, height and duration of an MP4 from its moov box: mvhd, and the first video track's tkhd."""
    data = Path(path).read_bytes()
    moov = next(((s, e) for kind, s, e in mp4_boxes(data, 0, len(data)) if kind == "moov"), None)
    if moov is None:
        raise Failure("the recording has no moov box")
    duration = width = height = None
    for kind, s, e in mp4_boxes(data, *moov):
        if kind == "mvhd":
            if data[s] == 1:
                timescale, length = struct.unpack(">IQ", data[s + 20:s + 32])
            else:
                timescale, length = struct.unpack(">II", data[s + 12:s + 20])
            duration = length / timescale if timescale else None
        elif kind == "trak" and width is None:
            for inner, ts, te in mp4_boxes(data, s, e):
                if inner == "tkhd":
                    w, h = struct.unpack(">II", data[te - 8:te])
                    if w and h:
                        width, height = w >> 16, h >> 16
    if not duration or not width:
        raise Failure("the recording's duration or size is unreadable")
    return {"width": width, "height": height, "duration_seconds": round(duration, 3)}


def probe(path):
    if shutil.which("ffprobe"):
        result = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
                                 "format=duration:stream=width,height,codec_name", "-of", "json", str(path)],
                                check=True, text=True, capture_output=True)
        data = json.loads(result.stdout)
        stream = data["streams"][0]
        info = {"width": stream["width"], "height": stream["height"],
                "duration_seconds": round(float(data["format"]["duration"]), 3), "codec": stream.get("codec_name")}
    else:
        info = mp4_info(path)
    if not math.isfinite(info["duration_seconds"]) or info["duration_seconds"] <= 0:
        raise Failure("the recording has no positive duration")
    info.update(bytes=Path(path).stat().st_size, sha256=digest(path))
    return info


def transcode(source, destination, original, max_bytes):
    # leave 1 MiB for the container; the size check afterwards is the authority
    bitrate = min(int(max(max_bytes - (1 << 20), 1) * 8 / original["duration_seconds"]), MAX_BITRATE)
    if bitrate < 150_000:
        raise Failure(f"a {original['duration_seconds']:.0f} s recording cannot fit {max_bytes:,} bytes at a readable bitrate")
    # simctl can give the last frame the previous sample's long duration; -t keeps the container's timeline
    subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-nostdin", "-y", "-fflags", "+igndts",
                    "-i", str(source), "-map", "0:v:0", "-an", "-t", str(original["duration_seconds"]),
                    "-vf", "scale=w='min(720,iw)':h=-2,fps=24", "-c:v", "libx264", "-preset", "medium",
                    "-b:v", str(bitrate), "-maxrate", str(bitrate), "-bufsize", str(bitrate * 2),
                    "-pix_fmt", "yuv420p", "-map_metadata", "-1", "-movflags", "+faststart", str(destination)],
                   check=True)
    video = probe(destination)
    if abs(video["duration_seconds"] - original["duration_seconds"]) > 0.5:
        raise Failure(f"transcoding changed the duration: {original['duration_seconds']} s to {video['duration_seconds']} s")
    video["transcoded"] = True
    return video


def video(source, destination_rel, out, transcoder, max_bytes, test_seconds=0.0):
    """(video entry, original entry, None) or (None, original or None, why there is no video)."""
    if not source.is_file() or source.stat().st_size == 0:
        return None, None, f"the run has no screen recording ({source.name})"
    try:
        original = probe(source)
    except (Failure, subprocess.CalledProcessError, KeyError, IndexError, ValueError, struct.error) as error:
        return None, None, f"the screen recording is unreadable: {error}"
    original["path_in_run"] = source.name
    seconds = original["duration_seconds"]
    if seconds < MIN_VIDEO_SECONDS or seconds < MIN_VIDEO_SHARE * test_seconds:
        return None, original, (f"the screen recording is truncated: {seconds:g} s for {test_seconds:g} s of tests "
                                "(the recorder stopped early, or recorded a display the app was not on)")
    destination = out / destination_rel
    destination.parent.mkdir(parents=True, exist_ok=True)
    have_ffmpeg = bool(shutil.which("ffmpeg") and shutil.which("ffprobe"))
    if transcoder == "ffmpeg" and not have_ffmpeg:
        return None, original, "--transcode ffmpeg, but ffmpeg or ffprobe is not installed"
    if transcoder in ("ffmpeg", "auto") and have_ffmpeg:
        try:
            result = transcode(source, destination, original, max_bytes)
        except (Failure, subprocess.CalledProcessError) as error:
            destination.unlink(missing_ok=True)
            return None, original, f"transcoding failed: {error}"
    elif original["bytes"] <= max_bytes:
        shutil.copyfile(source, destination)
        result = probe(destination)
        result["transcoded"] = False
    else:
        why = "--transcode none" if transcoder == "none" else "no ffmpeg"
        return None, original, f"{why}, and the {original['bytes']:,}-byte recording exceeds {max_bytes:,} bytes"
    if result["bytes"] > max_bytes:
        destination.unlink()
        return None, original, f"the exported copy is {result['bytes']:,} bytes, over {max_bytes:,}"
    result["path"] = destination_rel
    return result, original, None


# -- identity -------------------------------------------------------------------------------------------

def source_identity(run, given):
    source = dict(run.get("source") or {})
    recorded = source.get("revision")
    if recorded is not None and not (isinstance(recorded, str) and SHA.fullmatch(recorded)):
        raise Failure(f"run.json's source.revision {recorded!r} is not a full commit SHA")
    if given is not None and not SHA.fullmatch(given):
        raise Failure("--source-revision must be a full 40-character commit SHA")
    if recorded and given and recorded != given:
        raise Failure(f"--source-revision {given} is not the revision the run recorded ({recorded})")
    if not recorded:
        if not given:
            raise Failure("run.json records no tested revision: pass --source-revision (it is recorded as given)")
        source.update(revision=given, recorded_by="export-evidence --source-revision")
    return source


def journey_results(path):
    """[{name, result, seconds, failure?}] from LeanNative.Journey's journeys.json; None when there is none."""
    if not path.is_file():
        return None
    data = read_json(path, "the journeys' results")
    if not isinstance(data, list):
        raise Failure("journeys.json is not a list")
    journeys = []
    for j in data:
        if not (isinstance(j, dict) and isinstance(j.get("name"), str) and isinstance(j.get("passed"), bool)
                and isinstance(j.get("seconds"), (int, float))):
            raise Failure(f"journeys.json: malformed entry {j!r}")
        entry = {"name": j["name"], "result": "passed" if j["passed"] else "failed", "seconds": round(float(j["seconds"]), 3)}
        shots = j.get("screenshots", [])
        if not (isinstance(shots, list) and all(isinstance(s, str) for s in shots)):
            raise Failure(f"journeys.json: {j['name']}'s screenshots are not a list of names")
        entry["screenshots"] = shots
        if not j["passed"]:
            entry["failure"] = str(j.get("failure", ""))
        journeys.append(entry)
    return journeys


def device_identity(chosen, bundle_device, platform=None):
    result = {"name": chosen.get("name"), "type": chosen.get("type"), "runtime": chosen.get("runtime"), "os": chosen.get("os"),
              "model": chosen.get("model"), "architecture": chosen.get("architecture")}
    if bundle_device:
        if chosen.get("name") and bundle_device.get("name") and chosen["name"] != bundle_device["name"]:
            raise Failure(f"device.json chose {chosen['name']} but the tests ran on {bundle_device['name']}")
        allowed = BUNDLE_PLATFORMS.get(platform)
        if allowed and bundle_device.get("platform") and bundle_device["platform"] not in allowed:
            raise Failure(f"run.json records the tests as run on {platform} but the result bundle names {bundle_device['platform']}")
        result.update(name=bundle_device.get("name") or result["name"], platform=bundle_device.get("platform"),
                      os_version=bundle_device.get("os_version"), architecture=bundle_device.get("architecture") or result["architecture"])
    return {key: value for key, value in result.items() if value}


# -- the export -----------------------------------------------------------------------------------------

def journey_screenshots(on_disk, journeys, out):
    """The PNGs a journeys-only run wrote, attributed to the journeys that list them (the first is "test")."""
    written = {p.stem: p for p in on_disk.glob("*.png")} if on_disk and on_disk.is_dir() else {}
    listed = {}
    for j in journeys:
        for shot in j["screenshots"]:
            listed.setdefault(shot, []).append(j["name"])
    if stray := sorted(set(written) - set(listed)):
        raise Failure(f"screenshots on disk that no journey took: {', '.join(stray)}")
    if missing := sorted(set(listed) - set(written)):
        raise Failure(f"screenshots journeys.json lists but none was written: {', '.join(missing)}")
    entries = []
    if written:
        (out / "screenshots").mkdir(parents=True)
    for name in sorted(written):
        if not NAME.fullmatch(name):
            raise Failure(f"screenshot name {name!r}: letters, digits, '.', '_' and '-' only")
        target = out / "screenshots" / f"{name}.png"
        original = digest(written[name])
        shutil.copyfile(written[name], target)
        width, height = png_size(target)
        entry = {"name": name, "test": listed[name][0], "tests": sorted(set(listed[name])), "captures": 1,
                 "original_sha256": original, "path": f"screenshots/{name}.png", "width": width, "height": height,
                 "bytes": target.stat().st_size, "sha256": digest(target)}
        if entry["sha256"] != original:
            raise Failure(f"{name}.png changed while copied")
        entries.append(entry)
    return entries


def export_journeys(run_dir, out, args, run, name, source, now):
    """A run the app drove (driver "app" or "lanes"): results from journeys.json, screenshots from disk."""
    chosen = read_json(run_dir / "device.json", "the runner's device record")
    journeys = journey_results(run_dir / "journeys.json")
    if journeys is None:
        raise Failure("missing journeys.json (a run the app drove has no result bundle)")
    reasons = []
    failed = [j["name"] for j in journeys if j["result"] != "passed"]
    if not journeys:
        result, reasons = "incomplete", ["journeys.json lists no journey"]
    elif failed:
        result, reasons = "failed", ["journeys failed: " + ", ".join(failed)]
    elif run.get("exit_status") not in (0, None):
        result, reasons = "failed", [f"the run exited {run.get('exit_status')}"]
    else:
        result = "passed"
    lanes = run.get("lanes") or []
    if failed_lanes := [str(i + 1) for i, lane in enumerate(lanes) if lane.get("exit_status") not in (0, None)]:
        if result == "passed":
            result = "contradictory"
        reasons.append("lanes exited non-zero: " + ", ".join(failed_lanes))
    out.mkdir(parents=True, exist_ok=True)
    on_disk = (run_dir / args.screenshots) if args.screenshots else run_dir / "screenshots"
    shots = journey_screenshots(on_disk, journeys, out)
    # the recording is the first lane's (or the run's): it covers that lane's journeys
    recorded = set(lanes[0].get("journeys") or []) if lanes else {j["name"] for j in journeys}
    recorded_seconds = sum(j["seconds"] for j in journeys if j["name"] in recorded)
    recording, original, omitted = video(run_dir / f"{name}.mp4", args.video_out or f"video/{name}.mp4", out,
                                         args.transcode, args.max_video_bytes, recorded_seconds)
    artifacts = {"device.json": digest(run_dir / "device.json"), "run.json": digest(run_dir / "run.json"),
                 "journeys.json": digest(run_dir / "journeys.json")}
    if (run_dir / "journey.log").is_file():
        artifacts["journey.log"] = digest(run_dir / "journey.log")
    if args.app_metadata:
        artifacts["app_metadata"] = digest(args.app_metadata)
    evidence = {
        "schema": SCHEMA,
        "run": {"name": name, "scheme": run.get("scheme"), "platform": run.get("platform"), "driver": run.get("driver"),
                "lanes": lanes or None, "started_at": run.get("started_at"), "finished_at": run.get("finished_at"),
                "exit_status": run.get("exit_status"), "ci": run.get("ci"), "framework": run.get("framework")},
        "source": source,
        "device": device_identity(chosen, None, run.get("platform")),
        "result": result,
        "result_reasons": reasons,
        "test_seconds": round(sum(j["seconds"] for j in journeys), 3),
        "tests": [{"class": "journey", "name": j["name"], "result": j["result"], "bundle_result": None, "seconds": j["seconds"]}
                  for j in journeys],
        "screenshots": shots,
        "video": recording,
        "original_video": original,
        "artifacts_sha256": artifacts,
        "app": read_json(args.app_metadata, "the app metadata") if args.app_metadata else None,
        "exported": {"at": (now or datetime.now(timezone.utc)).replace(microsecond=0).isoformat(),
                     "by": "framework/native/ci/export-evidence"},
        "journeys": journeys,
    }
    if omitted:
        evidence["video_omitted"] = omitted
    (out / MANIFEST).write_text(json.dumps(evidence, indent=2) + "\n")
    return evidence


def export(run_dir, out, args, now=None):
    run_dir, out = Path(run_dir), Path(out)
    if not run_dir.is_dir():
        raise Failure(f"no run directory at {run_dir}")
    if out.exists() and any(out.iterdir()):
        raise Failure(f"{out} is not empty")
    run = read_json(run_dir / "run.json", "the runner's record")
    if run.get("schema") != 1:
        raise Failure(f"run.json schema {run.get('schema')!r}: this exporter reads schema 1")
    name = args.name or run.get("name") or "ui-tests"
    if not NAME.fullmatch(name):
        raise Failure(f"run name {name!r}: letters, digits, '.', '_' and '-' only")
    source = source_identity(run, args.source_revision)
    if run.get("driver") in ("app", "lanes"):
        return export_journeys(run_dir, out, args, run, name, source, now)
    chosen = read_json(run_dir / "device.json", "the runner's device record")
    bundle = run_dir / f"{name}.xcresult"
    log_path = run_dir / "xcodebuild.log"
    if not log_path.is_file():
        raise Failure("missing xcodebuild.log")
    if not bundle.is_dir():
        raise Failure(f"missing the result bundle {bundle.name}")
    text = xcresulttool("get", "test-results", "tests", "--path", str(bundle))
    if text is None:
        raise Failure(f"the result bundle {bundle.name} could not be read (xcresulttool)")
    try:
        bundled = parse_bundle_results(json.loads(text))
    except (ValueError, KeyError, TypeError) as error:
        raise Failure(f"the result bundle's results are malformed: {error}")
    log = parse_log(log_path.read_text(errors="replace"))
    result, reasons = outcome(bundled["tests"], log)
    journeys = journey_results(run_dir / "journeys.json")
    if journeys is not None:
        failed = [j["name"] for j in journeys if j["result"] != "passed"]
        if not journeys:
            result, reasons = ("incomplete" if result == "passed" else result), reasons + ["journeys.json lists no journey"]
        elif failed and result == "passed":
            result, reasons = "contradictory", reasons + ["the tests passed but journeys failed: " + ", ".join(failed)]
    device = device_identity(chosen, bundled["device"], run.get("platform"))
    app = read_json(args.app_metadata, "the app metadata") if args.app_metadata else None
    out.mkdir(parents=True, exist_ok=True)
    on_disk = (run_dir / args.screenshots) if args.screenshots else run_dir / "screenshots"
    with tempfile.TemporaryDirectory() as scratch:
        shots = screenshots(bundle, on_disk, out, Path(scratch))
    total = log["total_seconds"] if log["total_seconds"] is not None else sum(t["seconds"] for t in bundled["tests"])
    recording, original, omitted = video(run_dir / f"{name}.mp4", args.video_out or f"video/{name}.mp4", out,
                                         args.transcode, args.max_video_bytes, total)
    artifacts = {"xcodebuild.log": digest(log_path), "device.json": digest(run_dir / "device.json"),
                 "run.json": digest(run_dir / "run.json"), f"{name}.xcresult": tree_digest(bundle)}
    if args.app_metadata:
        artifacts["app_metadata"] = digest(args.app_metadata)
    if journeys is not None:
        artifacts["journeys.json"] = digest(run_dir / "journeys.json")
    evidence = {
        "schema": SCHEMA,
        "run": {"name": name, "scheme": run.get("scheme"), "platform": run.get("platform"),
                "started_at": run.get("started_at"), "finished_at": run.get("finished_at"),
                "exit_status": run.get("exit_status"), "ci": run.get("ci"), "framework": run.get("framework")},
        "source": source,
        "device": device,
        "result": result,
        "result_reasons": reasons,
        "test_seconds": round(total, 3),
        "tests": [{k: t[k] for k in ("class", "name", "result", "bundle_result", "seconds")} for t in bundled["tests"]],
        "screenshots": shots,
        "video": recording,
        "original_video": original,
        "artifacts_sha256": artifacts,
        "app": app,
        "exported": {"at": (now or datetime.now(timezone.utc)).replace(microsecond=0).isoformat(),
                     "by": "framework/native/ci/export-evidence"},
    }
    if journeys is not None:
        evidence["journeys"] = journeys
    if omitted:
        evidence["video_omitted"] = omitted
    (out / MANIFEST).write_text(json.dumps(evidence, indent=2) + "\n")
    return evidence


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("run", type=Path, help="a ui-tests evidence directory ($UI_OUT)")
    parser.add_argument("out", type=Path, help="where the export goes (absent or empty)")
    parser.add_argument("--name", help="the result bundle's and recording's name (default: run.json's, else ui-tests)")
    parser.add_argument("--screenshots", help="the run's screenshot directory, relative to <run> (default screenshots)")
    parser.add_argument("--video-out", help="the recording's path in <out> (default video/<name>.mp4)")
    parser.add_argument("--max-video-bytes", type=int, default=25 * 1024 * 1024)
    parser.add_argument("--transcode", choices=["auto", "ffmpeg", "none"], default="auto",
                        help="auto: ffmpeg when installed; ffmpeg: required; none: copy only")
    parser.add_argument("--app-metadata", type=Path, help="a JSON file recorded as the manifest's \"app\"")
    parser.add_argument("--source-revision", help="the tested commit: must match run.json's, or be given when it has none")
    parser.add_argument("--require-passed", action="store_true", help="exit 3 unless the run passed (after writing)")
    args = parser.parse_args(argv)
    try:
        evidence = export(args.run, args.out, args)
    except (Failure, OSError) as error:
        raise SystemExit(f"export-evidence: {error}")
    tests = evidence["tests"]
    print(f"{evidence['result']}: {sum(t['result'] == 'passed' for t in tests)}/{len(tests)} tests passed in "
          f"{evidence['test_seconds']} s at {evidence['source']['revision'][:12]}; {len(evidence['screenshots'])} screenshots; "
          + (f"video {evidence['video']['width']}x{evidence['video']['height']}, {evidence['video']['bytes']:,} bytes"
             if evidence["video"] else f"no video: {evidence['video_omitted']}"))
    for reason in evidence["result_reasons"]:
        print(f"  {reason}")
    print(f"wrote {args.out / MANIFEST}")
    if args.require_passed and evidence["result"] != "passed":
        sys.exit(3)


if __name__ == "__main__":
    main()
