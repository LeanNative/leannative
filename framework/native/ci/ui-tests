#!/bin/bash
# An ElmLean app's UI tests on a throwaway simulator, or as a Mac Catalyst app on this Mac, with a screen
# recording:
#
#   APP_DIR=… APP_ROOT=… SCHEME=… framework/native/ci/ui-tests [xcodebuild test arguments, e.g. -only-testing:…]
#
# The app's sources and project are prepared as build-ios does (its variables apply), then `xcodebuild test`
# runs on a simulator this script creates and deletes, never one that may hold a real install of the app.
# Evidence goes to $UI_OUT: <name>.xcresult, <name>.mp4 (the recording), xcodebuild.log, device.json, and
# run.json: what was tested, recorded as the run starts (schema 1: the platform, the app repository's commit
# and whether its tree was clean, the framework commit, the CI run when there is one, the runner's start and
# end times and exit status). framework/native/ci/export-evidence reads it; nothing else is the tested revision.
#
#   UI_PLATFORM     iossim (default) or maccatalyst: the app built for Mac Catalyst and tested on this Mac,
#                   in the logged-in session (the tests click, scroll and type with the real mouse and
#                   keyboard: a CI runner, not a Mac someone is using). It needs LEAN_X86_64_PREFIX, as
#                   build-ios does. The simulator variables below do not apply; device.json records the Mac.
#                   The recording is `screencapture -V`, converted to <name>.mp4 by avconvert; without the
#                   Screen Recording permission there is none, and recording.log says why.
#   UI_OUT          the evidence directory (default $IOS_DIR/build/ui-tests); emptied first, one run at a time
#   UI_NAME         the result bundle's and recording's name (default ui-tests)
#   UI_SIMULATOR    (simulator) an existing simulator to use instead (a name or UDID; it is not deleted)
#   UI_RUNTIME      (simulator) the iOS runtime, e.g. com.apple.CoreSimulator.SimRuntime.iOS-26-5 (default: the newest)
#   UI_DEVICE_TYPE  (simulator) the iPhone model (default iPhone 17 Pro), so screenshots keep their size from run to run;
#                   a runtime without it fails the run; device.json records it
#   UI_BEFORE       a command run as `$UI_BEFORE <UI_OUT>` once the device is chosen: the app's fixture
#                   (a node, files, a config). Each KEY=VALUE line it leaves in <UI_OUT>/test-env reaches the
#                   test runner as TEST_RUNNER_KEY, i.e. as KEY in the tests' environment.
#   UI_AFTER        a command run as `$UI_AFTER <UI_OUT> <simulator>` when the run ends, passed or not, while
#                   the simulator still exists: collect the app's files, stop the fixture (under Mac Catalyst
#                   the second argument is empty)
#   UI_SOURCE_REVISION  the tested commit, when the app directory is not a git checkout (else it must match)
#
# The CI log gets each test's result as it ends and a line every 30 s; the whole output is in xcodebuild.log.
set -euo pipefail
CI="$(cd "$(dirname "$0")" && pwd)"
APP_DIR="$(cd "${APP_DIR:?set APP_DIR to the app Lake package}" && pwd)"
SCHEME="${SCHEME:?set SCHEME to the Xcode scheme}"
IOS_DIR="${IOS_DIR:-$APP_DIR/ios}"
PROJECT="${PROJECT:-$IOS_DIR/$SCHEME.xcodeproj}"
OUT="${UI_OUT:-$IOS_DIR/build/ui-tests}"
NAME="${UI_NAME:-ui-tests}"
PLATFORM="${UI_PLATFORM:-iossim}"
case "$PLATFORM" in
  iossim) PLATFORM_NAME="iOS Simulator" ;;
  maccatalyst) PLATFORM_NAME="Mac Catalyst" ;;
  *) echo "UI_PLATFORM: iossim or maccatalyst" >&2; exit 2 ;;
esac
LOCK="${OUT%/}.lock"
mkdir -p "$(dirname "$LOCK")"
mkdir "$LOCK" 2>/dev/null || { echo "another ui-tests run is using $OUT ($LOCK)" >&2; exit 1; }
rm -rf "$OUT"
mkdir -p "$OUT"
OUT="$(cd "$OUT" && pwd)"

UDID=""
THROWAWAY=""
VIDEO_PID=""
AFTER_RAN=0
STATUS=""
# run.json: the identity at the start, the end time and exit status at the end (python3: no jq on runners)
record() {
  /usr/bin/python3 - "$OUT/run.json" "$@" <<'PY'
import datetime, json, os, re, subprocess, sys
path, what = sys.argv[1], sys.argv[2]
now = datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat()
def git(d, *a):
    try: return subprocess.run(["git", "-C", d, *a], check=True, text=True, capture_output=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError): return None
if what == "start":
    app, framework, name, scheme, platform = sys.argv[3:8]
    revision = git(app, "rev-parse", "HEAD")
    given = os.environ.get("UI_SOURCE_REVISION") or None
    if given and revision and given != revision:
        sys.exit(f"UI_SOURCE_REVISION {given} is not the checkout's {revision}")
    remote = git(app, "config", "--get", "remote.origin.url")
    if remote: remote = re.sub(r"//[^/@]*@", "//", remote)  # never a credential
    source = {"revision": revision or given, "recorded_by": "git" if revision else ("UI_SOURCE_REVISION" if given else None),
              "dirty": (git(app, "status", "--porcelain", "--untracked-files=no") or "") != "" if revision else None,
              "repository": remote, "path_in_repository": git(app, "rev-parse", "--show-prefix") if revision else None}
    ci = None
    if os.environ.get("GITHUB_RUN_ID"):
        ci = {k: os.environ.get(v) for k, v in [("server", "GITHUB_SERVER_URL"), ("repository", "GITHUB_REPOSITORY"),
              ("run_id", "GITHUB_RUN_ID"), ("run_attempt", "GITHUB_RUN_ATTEMPT"), ("workflow", "GITHUB_WORKFLOW"),
              ("job", "GITHUB_JOB"), ("event", "GITHUB_EVENT_NAME"), ("ref", "GITHUB_REF"), ("sha", "GITHUB_SHA")]}
    run = {"schema": 1, "runner": "framework/native/ci/ui-tests", "name": name, "scheme": scheme, "platform": platform,
           "started_at": now, "source": source, "framework": {"revision": git(framework, "rev-parse", "HEAD")}, "ci": ci}
else:
    run = json.load(open(path))
    run.update(finished_at=now, exit_status=int(sys.argv[3]))
with open(path + ".tmp", "w") as f: json.dump(run, f, indent=2); f.write("\n")
os.replace(path + ".tmp", path)
PY
}
# the Mac's recording, stopped and converted to the run's <name>.mp4 (H.264, as the simulator's)
stop_mac_recording() {
  local mov="$OUT/$NAME.mov"
  [ -n "$VIDEO_PID" ] && kill -INT "$VIDEO_PID" 2>/dev/null && wait "$VIDEO_PID" 2>/dev/null || true
  VIDEO_PID=""
  if [ ! -s "$mov" ]; then echo "screencapture wrote no recording (no Screen Recording permission?)" >> "$OUT/recording.log"; return; fi
  if avconvert --source "$mov" --preset Preset1280x720 --output "$OUT/$NAME.mp4" --replace >> "$OUT/recording.log" 2>&1; then
    rm -f "$mov"
  else
    echo "avconvert could not convert $NAME.mov; it is kept as recorded" >> "$OUT/recording.log"
    rm -f "$OUT/$NAME.mp4"
  fi
}
cleanup() {
  local code=$?
  if [ "$PLATFORM" = maccatalyst ]; then stop_mac_recording
  else [ -n "$VIDEO_PID" ] && kill -INT "$VIDEO_PID" 2>/dev/null && wait "$VIDEO_PID" 2>/dev/null || true; fi
  [ -f "$OUT/run.json" ] && record end "${STATUS:-$code}" || true
  if [ -n "${UI_AFTER:-}" ] && [ "$AFTER_RAN" = 0 ]; then AFTER_RAN=1; $UI_AFTER "$OUT" "$UDID" || true; fi
  if [ -n "$THROWAWAY" ]; then
    xcrun simctl shutdown "$THROWAWAY" >/dev/null 2>&1 || true
    xcrun simctl delete "$THROWAWAY" >/dev/null 2>&1 || true
  fi
  rmdir "$LOCK" 2>/dev/null || true
}
trap cleanup EXIT

record start "$APP_DIR" "$CI/../.." "$NAME" "$SCHEME" "$PLATFORM_NAME"
PREPARE_ONLY=1 "$CI/build-ios" Debug "$PLATFORM"

if [ "$PLATFORM" = maccatalyst ]; then
  # this Mac: no name here (the result bundle names it), the platform the app ran as, the host it ran on
  DEVICE="$(/usr/bin/python3 -c '
import json, platform, subprocess
def out(*a): return subprocess.run(a, check=True, text=True, capture_output=True).stdout.strip()
print(json.dumps({"platform": "Mac Catalyst", "type": "Mac", "model": out("sysctl", "-n", "hw.model"),
                  "os": "macOS " + out("sw_vers", "-productVersion") + " (" + out("sw_vers", "-buildVersion") + ")",
                  "architecture": platform.machine()}))')"
  DESTINATION="platform=macOS,variant=Mac Catalyst,arch=$(uname -m)"
elif [ -n "${UI_SIMULATOR:-}" ]; then
  UDID="$UI_SIMULATOR"
  DEVICE="$(xcrun simctl list -j | /usr/bin/python3 -c '
import json, sys
data = json.load(sys.stdin)
models = {t["identifier"]: t["name"] for t in data["devicetypes"]}
for runtime, devices in data["devices"].items():
    for d in devices:
        if sys.argv[1] in (d["udid"], d["name"]):
            kind = d.get("deviceTypeIdentifier")
            print(json.dumps({"name": models.get(kind, d["name"]), "type": kind, "runtime": runtime})); sys.exit()
print("{}")' "$UDID")"
else
  DEVICE="$(xcrun simctl list -j runtimes | UI_DEVICE_TYPE="${UI_DEVICE_TYPE:-iPhone 17 Pro}" /usr/bin/python3 -c '
import json, os, sys
runtimes = [r for r in json.load(sys.stdin)["runtimes"] if r.get("isAvailable") and r.get("platform", "iOS") == "iOS"
            and r["identifier"].startswith("com.apple.CoreSimulator.SimRuntime.iOS")]
wanted = os.environ.get("UI_RUNTIME")
if wanted:
    runtimes = [r for r in runtimes if r["identifier"] == wanted]
    if not runtimes: sys.exit("no available runtime " + wanted)
if not runtimes: sys.exit("no available iOS runtime")
runtime = max(runtimes, key=lambda r: [int(p) for p in r["version"].split(".") if p.isdigit()])
iphones = [t for t in runtime.get("supportedDeviceTypes", []) if t["name"].startswith("iPhone")]
if not iphones: sys.exit("no iPhone for " + runtime["identifier"])
chosen = next((t for t in iphones if t["name"] == os.environ["UI_DEVICE_TYPE"]), None)
if chosen is None:
    sys.exit(os.environ["UI_DEVICE_TYPE"] + " is not available on " + runtime["identifier"] + "; set UI_DEVICE_TYPE to one of: "
             + ", ".join(t["name"] for t in iphones))
print(json.dumps({"name": chosen["name"], "type": chosen["identifier"], "runtime": runtime["identifier"],
                  "os": runtime["name"]}))')"
  MODEL="$(/usr/bin/python3 -c 'import json, sys; print(json.loads(sys.argv[1])["type"])' "$DEVICE")"
  RUNTIME="$(/usr/bin/python3 -c 'import json, sys; print(json.loads(sys.argv[1])["runtime"])' "$DEVICE")"
  UDID=$(xcrun simctl create "$SCHEME UI tests $$" "$MODEL" "$RUNTIME")
  THROWAWAY="$UDID"
fi
[ "$PLATFORM" = iossim ] && DESTINATION="id=$UDID"
echo "$PLATFORM_NAME: $DEVICE"
printf '%s\n' "$DEVICE" > "$OUT/device.json"

[ -n "${UI_BEFORE:-}" ] && $UI_BEFORE "$OUT"
RUNNER_ENV=()
if [ -f "$OUT/test-env" ]; then
  while IFS='=' read -r key value; do
    [ -n "$key" ] && RUNNER_ENV+=("TEST_RUNNER_$key=$value")
  done < "$OUT/test-env"
fi

if [ "$PLATFORM" = maccatalyst ]; then
  # -V: a duration (stopped early by SIGINT) rather than -v, which waits for a key on a terminal there is none of
  screencapture -V 3600 -C -k "$OUT/$NAME.mov" < /dev/null >> "$OUT/recording.log" 2>&1 &
  VIDEO_PID=$!
else
  xcrun simctl boot "$UDID" 2>/dev/null || true
  xcrun simctl bootstatus "$UDID" -b >/dev/null
  xcrun simctl io "$UDID" recordVideo --codec=h264 --force "$OUT/$NAME.mp4" >/dev/null 2>&1 &
  VIDEO_PID=$!
fi

status=0
env ${RUNNER_ENV[@]+"${RUNNER_ENV[@]}"} xcodebuild test \
  -project "$PROJECT" -scheme "$SCHEME" -destination "$DESTINATION" \
  -derivedDataPath "${DERIVED_DATA:-$IOS_DIR/build/DerivedData}" -resultBundlePath "$OUT/$NAME.xcresult" \
  "$@" 2>&1 | "$CI/progress" "$OUT/xcodebuild.log" '^Test Case .*(passed|failed)|: error:|^\*\* TEST' || status=$?
STATUS="$status"
exit "$status"
