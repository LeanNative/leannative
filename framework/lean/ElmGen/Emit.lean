import ElmGen.Translate
/-!
# ElmGen.Emit

Prints `Generated.swift` from the intermediate tree: the shims, the user types at TOP LEVEL (so the
screen file and `Elements.swift` can name them), `enum <App>: ElmApp` with `initial` / `update` /
`view` and every reachable helper as a static member, and the judgment log as a trailer comment.
The file compiles against `framework/swift/Runtime.swift` alone (the macOS CLI) and together with
`Elements.swift` + the screen (iOS); it has no `import` and no top-level statement.
-/

namespace ElmGen
open Lean

def genHeader (r : GenResult) : List String :=
  [ s!"// GENERATED by elmgen from the elaborated Lean definitions reachable from `{r.appConst}` (Lean {Lean.versionString}).",
    s!"// Do not edit: regenerate with `lake exe elmgen --app {r.appConst} --name {r.appName} --screen-name {r.screenName} ...`.",
    s!"// Compiles with framework/swift/Runtime.swift (+ `runElmCli({r.appName}.self)` as main.swift for the CLI; + Elements.swift and the screen for iOS)." ]

def printType (t : TypeIR) : List String :=
  let conf := if t.equatable then ": Equatable" else ""
  docLines 0 t.doc ++
  match t.body with
  | .struct fields =>
    [s!"struct {t.swiftName}{conf} \{"] ++
    (fields.flatMap fun (n, ty, doc) => docLines 4 doc ++ [s!"    var {n}: {ty}"]) ++
    ["}"]
  | .enum indirect cases =>
    let ind := if indirect then "indirect " else ""
    [s!"{ind}enum {t.swiftName}{conf} \{"] ++
    (cases.flatMap fun (n, tys, doc) =>
      docLines 4 doc ++ [if tys.isEmpty then s!"    case {n}" else s!"    case {n}({", ".intercalate tys})"]) ++
    ["}"]

/-- A static member of the app enum (4-space indent). -/
def printDef (d : DefIR) : List String :=
  let cfg : PrintCfg := {}
  docLines 4 d.doc ++
  (if d.params.isEmpty then
    [s!"    static var {d.swiftName}: {d.ret} \{"]
  else
    let ps := ", ".intercalate (d.params.map fun (n, t) => s!"_ {n}: {t}")
    [s!"    static func {d.swiftName}({ps}) -> {d.ret} \{"]) ++
  [printStmts cfg 8 d.body, "    }"]

def judgmentTrailer (title : String) (js : Array String) : List String :=
  [s!"// ---- elmgen judgment log: {title} (also printed to stderr at generation time) ----"] ++
  (js.toList.zipIdx.map fun (j, i) => s!"// {i + 1}. {j}")

/-- The whole `Generated.swift`. -/
def renderGenerated (r : GenResult) : String :=
  let shims := r.shims.toList.map fun sh => (shimText sh).trimAsciiEnd.copy
  let types := r.types.toList.map fun t => "\n".intercalate (printType t)
  let members := (r.members.toList ++ r.defs.toList).map fun d => "\n".intercalate (printDef d)
  let parts :=
    ["\n".intercalate (genHeader r)] ++ shims ++ types ++
    [s!"enum {r.appName}: ElmApp \{\n" ++ "\n\n".intercalate members ++ "\n}"] ++
    ["\n".intercalate (judgmentTrailer "semantic decisions behind this translation" r.judgments)]
  "\n\n".intercalate parts ++ "\n"

end ElmGen
