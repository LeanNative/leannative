    .l "/// Zero-width spaces between the characters of a word of 20 or more characters (an address, a txid) let",
    .l "/// it wrap at characters instead of being hyphenated, so the screen never shows a character the string",
    .l "/// does not contain; shorter words still wrap at spaces.",
    b "static NSString *ELBreakable(NSString *s) {" [
        .l "BOOL longWord = NO;",
        b "for (NSString *w in [s componentsSeparatedByCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet]) {" [
            .l "__block NSUInteger n = 0;",
            .l "[w enumerateSubstringsInRange:NSMakeRange(0, w.length) options:NSStringEnumerationByComposedCharacterSequences",
            .l "                   usingBlock:^(NSString *c, NSRange r, NSRange e, BOOL *stop) { n++; }];",
            .l "if (n >= 20) { longWord = YES; break; }"],
        .l "if (!longWord) return s;",
        .l "NSMutableString *out = [NSMutableString string];",
        .l "NSScanner *scanner = [NSScanner scannerWithString:s];",
        .l "scanner.charactersToBeSkipped = nil;",
        .l "NSCharacterSet *spaces = NSCharacterSet.whitespaceAndNewlineCharacterSet;",
        b "while (!scanner.atEnd) {" [
            .l "NSString *gap = nil, *word = nil;",
            .l "if ([scanner scanCharactersFromSet:spaces intoString:&gap]) [out appendString:gap];",
            .l "if (![scanner scanUpToCharactersFromSet:spaces intoString:&word]) continue;",
            .l "__block NSUInteger n = 0;",
            .l "[word enumerateSubstringsInRange:NSMakeRange(0, word.length) options:NSStringEnumerationByComposedCharacterSequences",
            .l "                      usingBlock:^(NSString *c, NSRange r, NSRange e, BOOL *stop) { n++; }];",
            b "if (n < 20) {" [
                .l "[out appendString:word];",
                .l "continue;"],
            .l "__block BOOL first = YES;",
            .l "[word enumerateSubstringsInRange:NSMakeRange(0, word.length) options:NSStringEnumerationByComposedCharacterSequences",
            b "                      usingBlock:^(NSString *c, NSRange r, NSRange e, BOOL *stop) {" [
                .l "if (!first) [out appendString:@\"\\u200B\"];",
                .l "first = NO;",
                .l "[out appendString:c];"] "}];"],
        .l "return out;"],
