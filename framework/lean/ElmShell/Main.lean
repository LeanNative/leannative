import ElmShell.Header
import ElmShell.App
import ElmShell.Store
import ElmShell.Node
import ElmShell.Render
import ElmShell.Capabilities
import ElmShell.Check

/-! `elmshell <dir>`: writes the native shell's Objective-C into `<dir>` (a build directory: the files are
outputs, never sources). A file whose text is unchanged is left alone, so Xcode does not recompile it. -/

open ElmShell

def header (name : String) : List String :=
  [ s!"GENERATED by elmshell ({name}) from framework/lean/ElmShell (Lean {Lean.versionString}). Do not edit:",
    "framework/native/scripts/ios_lean_sources.sh writes it on every build." ]

def files : List (String × List Stmt) :=
  [ ("ElmLeanShell.h", headerFile), ("ELApp.m", appFile), ("ELStore.m", storeFile), ("ELNode.m", nodeFile),
    ("ELRender.m", renderFile), ("ELCapabilities.m", capsFile) ]

def main (args : List String) : IO UInt32 := do
  let [dir] := args | IO.eprintln "usage: elmshell <output dir>"; return 2
  unless Check.problems.isEmpty do
    for p in Check.problems do IO.eprintln s!"elmshell: {p}"
    return 1
  IO.FS.createDirAll dir
  for (name, body) in files do
    let path := System.FilePath.mk dir / name
    let text := ElmShell.file (header name) body
    let old ← (try IO.FS.readFile path catch _ => pure "")
    if old != text then IO.FS.writeFile path text
  -- a file from an older shell (a Swift one, say) must not linger in the build
  for entry in (← System.FilePath.readDir dir) do
    let shell := [".swift", ".m", ".h"].any fun (ext : String) => entry.fileName.endsWith ext
    if shell && !(files.any (·.1 == entry.fileName)) then
      IO.FS.removeFile entry.path
  return 0
