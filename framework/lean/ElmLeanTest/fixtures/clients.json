{
  "about": "Wire fixtures for ElmLean.Native.Client, written from the capability table (ElmShell/Capabilities.lean, ElmShell/CloudKit.lean), not from the decoders. Each case names a request the test builds (ElmLeanTest/Clients.lean), the arguments it must send, a reply the shell may answer, and the expected typed result: {\"ok\": rendering} or {\"error\": {kind, name, code?, domain?}}.",
  "cases": [
    {"name": "auth: authenticated", "request": "auth", "capability": "auth", "args": {"reason": "Unlock the vault"},
     "reply": {"ok": true}, "expect": {"ok": {"note": null}}},
    {"name": "auth: simulator without a passcode", "request": "auth", "reply": {"ok": true, "note": "simulator without a passcode"},
     "expect": {"ok": {"note": "simulator without a passcode"}}},
    {"name": "auth: the person cancelled", "request": "auth", "reply": {"ok": false, "error": "Canceled by user.", "name": "userCancel", "code": -2},
     "expect": {"error": {"kind": "cancelled", "name": "userCancel", "code": -2}}},
    {"name": "auth: the system cancelled", "request": "auth", "reply": {"ok": false, "error": "Canceled by another authentication.", "name": "systemCancel", "code": -4},
     "expect": {"error": {"kind": "cancelled", "name": "systemCancel", "code": -4}}},
    {"name": "auth: failed", "request": "auth", "reply": {"ok": false, "error": "Application retry limit exceeded.", "name": "authenticationFailed", "code": -1},
     "expect": {"error": {"kind": "denied", "name": "authenticationFailed", "code": -1}}},
    {"name": "auth: no passcode on a device", "request": "auth", "reply": {"ok": false, "error": "Set a device passcode first.", "name": "passcodeNotSet", "code": -5},
     "expect": {"error": {"kind": "unsupported", "name": "passcodeNotSet", "code": -5}}},
    {"name": "auth: an older shell, text only", "request": "auth", "reply": {"ok": false, "error": "Authentication failed."},
     "expect": {"error": {"kind": "failed", "name": "unknown"}}},
    {"name": "auth: an LAError this client does not know", "request": "auth", "reply": {"ok": false, "error": "?", "name": "companionNotAvailable", "code": -11},
     "expect": {"error": {"kind": "failed", "name": "companionNotAvailable", "code": -11}}},
    {"name": "auth: ok missing", "request": "auth", "reply": {"note": "?"}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "auth: ok not a boolean", "request": "auth", "reply": {"ok": "yes"}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "auth: not an object", "request": "auth", "reply": [true], "expect": {"error": {"kind": "malformed"}}},

    {"name": "keychain.get: bytes", "request": "keychain.get", "capability": "keychain.get",
     "args": {"key": "wallet", "service": "org.example.app", "hex": true},
     "reply": {"hex": "00ff10", "status": 0}, "expect": {"ok": {"bytes": "00ff10"}}},
    {"name": "keychain.get: no such item", "request": "keychain.get", "reply": {"hex": null, "status": -25300}, "expect": {"ok": {"bytes": null}}},
    {"name": "keychain.get: locked device", "request": "keychain.get", "reply": {"hex": null, "status": -25308},
     "expect": {"error": {"kind": "failed", "name": "status -25308", "code": -25308}}},
    {"name": "keychain.get: no keychain access group (ad-hoc Catalyst)", "request": "keychain.get", "reply": {"hex": null, "status": -34018},
     "expect": {"error": {"kind": "unsupported", "name": "status -34018", "code": -34018}}},
    {"name": "keychain.get: no status (never a default)", "request": "keychain.get", "reply": {"hex": null}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "keychain.get: bad hex", "request": "keychain.get", "reply": {"hex": "0g", "status": 0}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "keychain.get: status 0 without bytes", "request": "keychain.get", "reply": {"hex": null, "status": 0}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "keychain.get: bytes with not-found", "request": "keychain.get", "reply": {"hex": "00", "status": -25300}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "keychain.getText: text", "request": "keychain.getText", "capability": "keychain.get", "args": {"key": "wallet", "service": "org.example.app"},
     "reply": {"value": "secret words", "status": 0}, "expect": {"ok": {"text": "secret words"}}},
    {"name": "keychain.getText: not UTF-8", "request": "keychain.getText", "reply": {"value": null, "status": 0},
     "expect": {"error": {"kind": "failed", "name": "notText"}}},
    {"name": "keychain.set: replaced", "request": "keychain.set", "capability": "keychain.set",
     "args": {"key": "wallet", "service": "org.example.app", "synchronizable": true, "hex": "00ff"},
     "reply": {"ok": true, "status": 0}, "expect": {"ok": {}}},
    {"name": "keychain.set: bad parameter", "request": "keychain.set", "reply": {"ok": false, "status": -50},
     "expect": {"error": {"kind": "failed", "name": "status -50", "code": -50}}},
    {"name": "keychain.set: ok contradicts status", "request": "keychain.set", "reply": {"ok": true, "status": -25308}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "keychain.add: added", "request": "keychain.add", "capability": "keychain.add",
     "args": {"key": "wallet", "service": "org.example.app", "hex": "01"},
     "reply": {"ok": true, "status": 0, "exists": false}, "expect": {"ok": "added"}},
    {"name": "keychain.add: already exists, untouched", "request": "keychain.add", "reply": {"ok": false, "status": -25299, "exists": true},
     "expect": {"ok": "alreadyExists"}},
    {"name": "keychain.add: the person cancelled", "request": "keychain.add", "reply": {"ok": false, "status": -128, "exists": false},
     "expect": {"error": {"kind": "cancelled", "name": "status -128", "code": -128}}},
    {"name": "keychain.add: an older shell", "request": "keychain.add", "reply": {"error": "unknown capability keychain.add"},
     "expect": {"error": {"kind": "unsupported", "name": "unknownCapability"}}},
    {"name": "keychain.delete: also when missing", "request": "keychain.delete", "capability": "keychain.delete",
     "args": {"key": "wallet", "service": "org.example.app"},
     "reply": {"ok": true, "status": -25300}, "expect": {"ok": {}}},
    {"name": "keychain.delete: denied", "request": "keychain.delete", "reply": {"ok": false, "status": -25293},
     "expect": {"error": {"kind": "denied", "name": "status -25293", "code": -25293}}},
    {"name": "keychain.clear", "request": "keychain.clear", "capability": "keychain.clear", "args": {"service": "org.example.test"},
     "reply": {"ok": true, "status": 0}, "expect": {"ok": {}}},

    {"name": "http.get: a response", "request": "http.get", "capability": "http.get",
     "args": {"url": "https://example.com/a", "maxBytes": 100, "timeout": 5, "accept": "application/json", "socks": {"host": "127.0.0.1", "port": 9050}},
     "reply": {"status": 200, "body": "6869"}, "expect": {"ok": {"status": 200, "body": "6869"}}},
    {"name": "http.get: a 404 is a response", "request": "http.get.plain", "capability": "http.get", "args": {"url": "https://example.com/", "maxBytes": 1000000},
     "reply": {"status": 404, "body": ""}, "expect": {"ok": {"status": 404, "body": ""}}},
    {"name": "http.get: too large", "request": "http.get.plain", "reply": {"error": "tooLarge"}, "expect": {"error": {"kind": "failed", "name": "tooLarge"}}},
    {"name": "http.get: bad proxy", "request": "http.get.plain", "reply": {"error": "bad-proxy"}, "expect": {"error": {"kind": "failed", "name": "bad-proxy"}}},
    {"name": "http.get: no response", "request": "http.get.plain", "reply": {"error": "response"}, "expect": {"error": {"kind": "failed", "name": "response"}}},
    {"name": "http.get: cancelled", "request": "http.get.plain", "reply": {"error": "cancelled", "code": -999, "domain": "NSURLErrorDomain"},
     "expect": {"error": {"kind": "cancelled", "name": "system", "code": -999, "domain": "NSURLErrorDomain"}}},
    {"name": "http.get: offline", "request": "http.get.plain", "reply": {"error": "The Internet connection appears to be offline.", "code": -1009, "domain": "NSURLErrorDomain"},
     "expect": {"error": {"kind": "failed", "name": "system", "code": -1009, "domain": "NSURLErrorDomain"}}},
    {"name": "http.get: a system error from an older shell keeps its text", "request": "http.get.plain", "reply": {"error": "Could not connect to the server."},
     "expect": {"error": {"kind": "failed", "name": "Could not connect to the server."}}},
    {"name": "http.get: body not hex", "request": "http.get.plain", "reply": {"status": 200, "body": "xyz"}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "http.get: no status", "request": "http.get.plain", "reply": {"body": "00"}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "http.get: negative status", "request": "http.get.plain", "reply": {"status": -1, "body": ""}, "expect": {"error": {"kind": "malformed"}}},

    {"name": "cloudkit.account: available", "request": "cloudkit.account", "capability": "cloudkit.account", "args": {"container": "iCloud.org.example.app"},
     "reply": {"status": "available", "user": "_abc"}, "expect": {"ok": {"status": "available", "user": "_abc"}}},
    {"name": "cloudkit.account: no account", "request": "cloudkit.account", "reply": {"status": "noAccount", "user": null},
     "expect": {"ok": {"status": "noAccount", "user": null}}},
    {"name": "cloudkit.account: available without a user", "request": "cloudkit.account", "reply": {"status": "available"}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "cloudkit.account: an unknown status", "request": "cloudkit.account", "reply": {"status": "maybe", "user": null}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "cloudkit.account: no entitlement", "request": "cloudkit.account", "reply": {"error": "missingEntitlement", "detail": "no CloudKit in the com.apple.developer.icloud-services entitlement"},
     "expect": {"error": {"kind": "unsupported", "name": "missingEntitlement"}}},
    {"name": "cloudkit.account: not signed in", "request": "cloudkit.account", "reply": {"error": "notAuthenticated", "code": 9, "detail": "?"},
     "expect": {"error": {"kind": "denied", "name": "notAuthenticated", "code": 9}}},
    {"name": "cloudkit.query: records", "request": "cloudkit.query", "capability": "cloudkit.query",
     "args": {"type": "Note", "equals": {"network": "signet"}, "sortBy": "savedAt", "ascending": false, "keys": ["network", "savedAt"], "limit": 500},
     "reply": {"records": [{"name": "n1", "type": "Note", "fields": {"network": "signet", "savedAt": {"date": 1.5}, "blob": {"hex": "00"}, "file": {"asset": true}, "parent": {"ref": "n0"}, "tags": ["a", 2]}, "modified": 2.5, "tag": "t1"}], "more": false},
     "expect": {"ok": {"records": [{"name": "n1", "type": "Note", "modified": 2.5, "tag": "t1",
       "fields": {"network": "signet", "savedAt": {"date": 1.5}, "blob": {"hex": "00"}, "file": {"asset": true}, "parent": {"ref": "n0"}, "tags": ["a", 2]}}], "more": false}}},
    {"name": "cloudkit.query: a field of unknown kind", "request": "cloudkit.query", "reply": {"records": [{"name": "n", "type": "Note", "fields": {"x": {"location": [1, 2]}}}], "more": false},
     "expect": {"error": {"kind": "malformed"}}},
    {"name": "cloudkit.query: no records", "request": "cloudkit.query", "reply": {"more": false}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "cloudkit.query: rate limited", "request": "cloudkit.query", "reply": {"error": "requestRateLimited", "code": 7, "detail": "slow down", "retryAfter": 30},
     "expect": {"error": {"kind": "failed", "name": "requestRateLimited", "code": 7}, "retryAfter": 30}},
    {"name": "cloudkit.query: an error name this client does not know", "request": "cloudkit.query", "reply": {"error": "somethingNew", "code": 99},
     "expect": {"error": {"kind": "failed", "name": "somethingNew", "code": 99}}},
    {"name": "cloudkit.save: saved", "request": "cloudkit.save", "capability": "cloudkit.save",
     "args": {"type": "Note", "name": "n1", "fields": {"network": "signet", "savedAt": {"date": 1.5}}, "asset": "0102", "assetField": "payload"},
     "reply": {"ok": true, "record": {"name": "n1", "type": "Note", "fields": {"network": "signet", "payload": {"asset": true}}, "modified": null, "tag": null}},
     "expect": {"ok": {"name": "n1", "type": "Note", "modified": null, "tag": null, "fields": {"network": "signet", "payload": {"asset": true}}}}},
    {"name": "cloudkit.save: changed on the server", "request": "cloudkit.save", "reply": {"error": "serverRecordChanged", "code": 14, "detail": "?"},
     "expect": {"error": {"kind": "failed", "name": "serverRecordChanged", "code": 14}}},
    {"name": "cloudkit.save: cancelled", "request": "cloudkit.save", "reply": {"error": "operationCancelled", "code": 20},
     "expect": {"error": {"kind": "cancelled", "name": "operationCancelled", "code": 20}}},
    {"name": "cloudkit.save: ok without a record", "request": "cloudkit.save", "reply": {"ok": true}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "cloudkit.load: with its asset", "request": "cloudkit.load", "capability": "cloudkit.load", "args": {"name": "n1", "maxBytes": 1024, "assetField": "payload"},
     "reply": {"record": {"name": "n1", "type": "Note", "fields": {}, "modified": 3, "tag": "t"}, "asset": "0a0b"},
     "expect": {"ok": {"record": {"name": "n1", "type": "Note", "fields": {}, "modified": 3, "tag": "t"}, "asset": "0a0b"}}},
    {"name": "cloudkit.load: no asset", "request": "cloudkit.load", "reply": {"record": {"name": "n1", "type": "Note", "fields": {}}, "asset": null},
     "expect": {"ok": {"record": {"name": "n1", "type": "Note", "fields": {}, "modified": null, "tag": null}, "asset": null}}},
    {"name": "cloudkit.load: not found", "request": "cloudkit.load", "reply": {"error": "notFound"}, "expect": {"error": {"kind": "failed", "name": "notFound"}}},
    {"name": "cloudkit.load: too large", "request": "cloudkit.load", "reply": {"error": "tooLarge"}, "expect": {"error": {"kind": "failed", "name": "tooLarge"}}},
    {"name": "cloudkit.load: asset not hex", "request": "cloudkit.load", "reply": {"record": {"name": "n1", "type": "Note", "fields": {}}, "asset": "zz"},
     "expect": {"error": {"kind": "malformed"}}},
    {"name": "cloudkit.delete", "request": "cloudkit.delete", "capability": "cloudkit.delete", "args": {"name": "n1"},
     "reply": {"ok": true}, "expect": {"ok": {}}},
    {"name": "cloudkit.delete: network", "request": "cloudkit.delete", "reply": {"error": "networkUnavailable", "code": 3},
     "expect": {"error": {"kind": "failed", "name": "networkUnavailable", "code": 3}}},

    {"name": "ble.state", "request": "ble.state", "capability": "ble.state", "args": {}, "reply": {"state": "poweredOn"}, "expect": {"ok": "poweredOn"}},
    {"name": "ble.state: unknown name", "request": "ble.state", "reply": {"state": "sleepy"}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "ble.connect: connected", "request": "ble.connect", "capability": "ble.connect", "args": {"services": ["13D63400-2C97-0004-0000-4C6564676572"], "timeout": 45},
     "reply": {"ok": true, "id": "p1", "service": "13D63400-2C97-0004-0000-4C6564676572", "characteristics": ["c1", "c2"]},
     "expect": {"ok": {"id": "p1", "service": "13D63400-2C97-0004-0000-4C6564676572", "characteristics": ["c1", "c2"]}}},
    {"name": "ble.connect: not allowed", "request": "ble.connect", "reply": {"ok": false, "error": "unauthorized"}, "expect": {"error": {"kind": "denied", "name": "unauthorized"}}},
    {"name": "ble.connect: no Bluetooth LE", "request": "ble.connect", "reply": {"ok": false, "error": "unsupported"}, "expect": {"error": {"kind": "unsupported", "name": "unsupported"}}},
    {"name": "ble.connect: timeout", "request": "ble.connect", "reply": {"ok": false, "error": "timeout"}, "expect": {"error": {"kind": "failed", "name": "timeout"}}},
    {"name": "ble.connect: ok without an id", "request": "ble.connect", "reply": {"ok": true, "service": "s", "characteristics": []}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "ble.connect: ok false without an error", "request": "ble.connect", "reply": {"ok": false}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "ble.subscribe", "request": "ble.subscribe", "capability": "ble.subscribe", "args": {"id": "p1", "characteristic": "c1", "timeout": 90},
     "reply": {"ok": true}, "expect": {"ok": {}}},
    {"name": "ble.subscribe: busy", "request": "ble.subscribe", "reply": {"ok": false, "error": "busy"}, "expect": {"error": {"kind": "failed", "name": "busy"}}},
    {"name": "ble.write", "request": "ble.write", "capability": "ble.write", "args": {"id": "p1", "characteristic": "c2", "hex": "0800", "response": true, "timeout": 15},
     "reply": {"ok": true}, "expect": {"ok": {}}},
    {"name": "ble.write: disconnected", "request": "ble.write", "reply": {"ok": false, "error": "disconnected"}, "expect": {"error": {"kind": "failed", "name": "disconnected"}}},
    {"name": "ble.read: a value", "request": "ble.read", "capability": "ble.read", "args": {"id": "p1", "characteristic": "c1", "timeout": 30},
     "reply": {"hex": "0500"}, "expect": {"ok": "0500"}},
    {"name": "ble.read: timeout", "request": "ble.read", "reply": {"error": "timeout"}, "expect": {"error": {"kind": "failed", "name": "timeout"}}},
    {"name": "ble.read: neither hex nor error", "request": "ble.read", "reply": {}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "ble.close", "request": "ble.close", "capability": "ble.close", "args": {"id": "p1"}, "reply": {"ok": true}, "expect": {"ok": {}}}
  ]
}
