     "reply": {"directory": "/tmp/cloudkit-1", "records": [
       {"name": "n1", "record": {"name": "n1", "type": "Note", "fields": {}, "modified": 3, "tag": "t"}, "file": "/tmp/cloudkit-1/0"},
       {"name": "n2", "error": "notFound", "code": 11, "detail": "Record not found"},
