{
  "about": "Wire fixtures for LeanNative.Native.Client, written from the capability table (LeanNativeShell/Capabilities.lean, LeanNativeShell/CloudKit.lean), not from the decoders. Each case names a request the test builds (LeanNativeTest/Clients.lean), the arguments it must send, a reply the shell may answer, and the expected typed result: {\"ok\": rendering} or {\"error\": {kind, name, code?, domain?}}.",
  "cases": [
    {"name": "auth: authenticated", "request": "auth", "capability": "auth", "args": {"reason": "Unlock the vault"},
     "reply": {"ok": true}, "expect": {"ok": {"note": null}}},
    {"name": "auth: simulator without a passcode", "request": "auth", "reply": {"ok": true, "note": "simulator without a passcode"},
     "expect": {"ok": {"note": "simulator without a passcode"}}},
    {"name": "auth: the person cancelled", "request": "auth", "reply": {"ok": false, "error": "Canceled by user.", "name": "userCancel", "code": -2},
     "expect": {"error": {"kind": "cancelled", "name": "userCancel", "code": -2}}},
    {"name": "auth: the system cancelled", "request": "auth", "reply": {"ok": false, "error": "Canceled by another authentication.", "name": "systemCancel", "code": -4},
     "expect": {"error": {"kind": "cancelled", "name": "systemCancel", "code": -4}}},
    {"name": "auth: failed", "request": "auth", "reply": {"ok": false, "error": "Application retry limit exceeded.", "name": "authenticationFailed", "code": -1},
     "expect": {"error": {"kind": "denied", "name": "authenticationFailed", "code": -1}}},
    {"name": "auth: no passcode on a device", "request": "auth", "reply": {"ok": false, "error": "Set a device passcode first.", "name": "passcodeNotSet", "code": -5},
     "expect": {"error": {"kind": "unsupported", "name": "passcodeNotSet", "code": -5}}},
    {"name": "auth: an older shell, text only", "request": "auth", "reply": {"ok": false, "error": "Authentication failed."},
     "expect": {"error": {"kind": "failed", "name": "unknown"}}},
    {"name": "auth: an LAError this client does not know", "request": "auth", "reply": {"ok": false, "error": "?", "name": "companionNotAvailable", "code": -11},
     "expect": {"error": {"kind": "failed", "name": "companionNotAvailable", "code": -11}}},
    {"name": "auth: ok missing", "request": "auth", "reply": {"note": "?"}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "auth: ok not a boolean", "request": "auth", "reply": {"ok": "yes"}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "auth: not an object", "request": "auth", "reply": [true], "expect": {"error": {"kind": "malformed"}}},
    {"name": "auth with keep: authenticated, the authentication kept", "request": "auth.keep", "capability": "auth",
     "args": {"reason": "Send 0.1 BTC", "keep": 30},
     "reply": {"ok": true, "context": "5C2B4E0E-6C0B-4F27-9B43-0B2B1C3A7D11"},
     "expect": {"ok": {"note": null, "context": "5C2B4E0E-6C0B-4F27-9B43-0B2B1C3A7D11"}}},
    {"name": "auth with keep: answered in the background, nothing kept", "request": "auth.keep", "reply": {"ok": true},
     "expect": {"ok": {"note": null, "context": null}}},
    {"name": "auth with keep: simulator without a passcode", "request": "auth.keep",
     "reply": {"ok": true, "note": "simulator without a passcode", "context": "0E8A7B52-1D6F-4A3C-8E57-52A0C1D4F9B6"},
     "expect": {"ok": {"note": "simulator without a passcode", "context": "0E8A7B52-1D6F-4A3C-8E57-52A0C1D4F9B6"}}},
    {"name": "auth with keep: the person cancelled", "request": "auth.keep", "reply": {"ok": false, "error": "Canceled by user.", "name": "userCancel", "code": -2},
     "expect": {"error": {"kind": "cancelled", "name": "userCancel", "code": -2}}},
    {"name": "auth with keep: context not a string", "request": "auth.keep", "reply": {"ok": true, "context": 7}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "auth.end: ended", "request": "auth.end", "capability": "auth.end", "args": {"context": "5C2B4E0E-6C0B-4F27-9B43-0B2B1C3A7D11"},
     "reply": {"ok": true}, "expect": {"ok": {}}},
    {"name": "auth.end: an older shell", "request": "auth.end", "reply": {"error": "unknown capability auth.end"},
     "expect": {"error": {"kind": "unsupported", "name": "unknownCapability"}}},
    {"name": "auth.end: ok missing", "request": "auth.end", "reply": {}, "expect": {"error": {"kind": "malformed"}}},

    {"name": "webauth: the callback URL", "request": "webauth", "capability": "webauth",
     "args": {"url": "https://id.example.com/authorize?client_id=c&state=s", "callbackHost": "app.example.com", "callbackPath": "/oauth/callback"},
     "reply": {"ok": true, "url": "https://app.example.com/oauth/callback?code=abc&state=s"},
     "expect": {"ok": "https://app.example.com/oauth/callback?code=abc&state=s"}},
    {"name": "webauth: a custom scheme, ephemeral", "request": "webauth.scheme", "capability": "webauth",
     "args": {"url": "https://id.example.com/authorize", "callbackScheme": "exampleapp", "ephemeral": true},
     "reply": {"ok": true, "url": "exampleapp://done?code=abc"}, "expect": {"ok": "exampleapp://done?code=abc"}},
    {"name": "webauth: the person closed the sheet", "request": "webauth",
     "reply": {"ok": false, "error": "The operation couldn’t be completed.", "name": "canceledLogin", "code": 1, "domain": "com.apple.AuthenticationServices.WebAuthenticationSession"},
     "expect": {"error": {"kind": "cancelled", "name": "canceledLogin", "code": 1, "domain": "com.apple.AuthenticationServices.WebAuthenticationSession"}}},
    {"name": "webauth: an https callback below iOS 17.4", "request": "webauth", "reply": {"ok": false, "error": "An https callback needs iOS 17.4.", "name": "unsupported"},
     "expect": {"error": {"kind": "unsupported", "name": "unsupported"}}},
    {"name": "webauth: no window to present from", "request": "webauth",
     "reply": {"ok": false, "error": "?", "name": "presentationContextInvalid", "code": 3, "domain": "com.apple.AuthenticationServices.WebAuthenticationSession"},
     "expect": {"error": {"kind": "failed", "name": "presentationContextInvalid", "code": 3}}},
    {"name": "webauth: one at a time", "request": "webauth", "reply": {"ok": false, "error": "A sign-in is already open.", "name": "busy"},
     "expect": {"error": {"kind": "failed", "name": "busy"}}},
    {"name": "webauth: ok without a url", "request": "webauth", "reply": {"ok": true}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "webauth: ok not a boolean", "request": "webauth", "reply": {"ok": "yes", "url": "x"}, "expect": {"error": {"kind": "malformed"}}},

    {"name": "keychain.get: bytes", "request": "keychain.get", "capability": "keychain.get",
     "args": {"key": "wallet", "service": "org.example.app", "hex": true},
     "reply": {"hex": "00ff10", "status": 0}, "expect": {"ok": {"bytes": "00ff10"}}},
    {"name": "keychain.get: no such item", "request": "keychain.get", "reply": {"hex": null, "status": -25300}, "expect": {"ok": {"bytes": null}}},
    {"name": "keychain.get: locked device", "request": "keychain.get", "reply": {"hex": null, "status": -25308},
     "expect": {"error": {"kind": "failed", "name": "status -25308", "code": -25308}}},
    {"name": "keychain.get: no keychain access group (ad-hoc Catalyst)", "request": "keychain.get", "reply": {"hex": null, "status": -34018},
     "expect": {"error": {"kind": "unsupported", "name": "status -34018", "code": -34018}}},
    {"name": "keychain.get: no status (never a default)", "request": "keychain.get", "reply": {"hex": null}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "keychain.get: bad hex", "request": "keychain.get", "reply": {"hex": "0g", "status": 0}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "keychain.get: status 0 without bytes", "request": "keychain.get", "reply": {"hex": null, "status": 0}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "keychain.get: bytes with not-found", "request": "keychain.get", "reply": {"hex": "00", "status": -25300}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "keychain.getText: text", "request": "keychain.getText", "capability": "keychain.get", "args": {"key": "wallet", "service": "org.example.app"},
     "reply": {"value": "secret words", "status": 0}, "expect": {"ok": {"text": "secret words"}}},
    {"name": "keychain.getText: not UTF-8", "request": "keychain.getText", "reply": {"value": null, "status": 0},
     "expect": {"error": {"kind": "failed", "name": "notText"}}},
    {"name": "keychain.set: replaced", "request": "keychain.set", "capability": "keychain.set",
     "args": {"key": "wallet", "service": "org.example.app", "synchronizable": true, "hex": "00ff"},
     "reply": {"ok": true, "status": 0}, "expect": {"ok": {}}},
    {"name": "keychain.set: bad parameter", "request": "keychain.set", "reply": {"ok": false, "status": -50},
     "expect": {"error": {"kind": "failed", "name": "status -50", "code": -50}}},
    {"name": "keychain.set: ok contradicts status", "request": "keychain.set", "reply": {"ok": true, "status": -25308}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "keychain.add: added", "request": "keychain.add", "capability": "keychain.add",
     "args": {"key": "wallet", "service": "org.example.app", "hex": "01"},
     "reply": {"ok": true, "status": 0, "exists": false}, "expect": {"ok": "added"}},
    {"name": "keychain.add: already exists, untouched", "request": "keychain.add", "reply": {"ok": false, "status": -25299, "exists": true},
     "expect": {"ok": "alreadyExists"}},
    {"name": "keychain.add: the person cancelled", "request": "keychain.add", "reply": {"ok": false, "status": -128, "exists": false},
     "expect": {"error": {"kind": "cancelled", "name": "status -128", "code": -128}}},
    {"name": "keychain.add: an older shell", "request": "keychain.add", "reply": {"error": "unknown capability keychain.add"},
     "expect": {"error": {"kind": "unsupported", "name": "unknownCapability"}}},
    {"name": "keychain.delete: also when missing", "request": "keychain.delete", "capability": "keychain.delete",
     "args": {"key": "wallet", "service": "org.example.app"},
     "reply": {"ok": true, "status": -25300}, "expect": {"ok": {}}},
    {"name": "keychain.delete: denied", "request": "keychain.delete", "reply": {"ok": false, "status": -25293},
     "expect": {"error": {"kind": "denied", "name": "status -25293", "code": -25293}}},
    {"name": "keychain.clear", "request": "keychain.clear", "capability": "keychain.clear", "args": {"service": "org.example.test"},
     "reply": {"ok": true, "status": 0}, "expect": {"ok": {}}},
    {"name": "keychain.get with a context: bytes", "request": "keychain.get.context", "capability": "keychain.get",
     "args": {"key": "seed", "service": "org.example.app", "access": "userPresence", "hex": true, "context": "5C2B4E0E-6C0B-4F27-9B43-0B2B1C3A7D11"},
     "reply": {"hex": "00ff10", "status": 0}, "expect": {"ok": {"bytes": "00ff10"}}},
    {"name": "keychain.get with a context: ended, or never was (no prompt: refused)", "request": "keychain.get.context", "reply": {"hex": null, "status": -25308},
     "expect": {"error": {"kind": "failed", "name": "status -25308", "code": -25308}}},
    {"name": "keychain.get behind the person's presence, no context: refused", "request": "keychain.get.presence", "capability": "keychain.get",
     "args": {"key": "seed", "service": "org.example.app", "access": "userPresence", "hex": true},
     "reply": {"hex": null, "status": -25308}, "expect": {"error": {"kind": "failed", "name": "status -25308", "code": -25308}}},
    {"name": "keychain.getText with a context: text", "request": "keychain.getText.context", "capability": "keychain.get",
     "args": {"key": "seed", "service": "org.example.app", "access": "userPresence", "context": "5C2B4E0E-6C0B-4F27-9B43-0B2B1C3A7D11"},
     "reply": {"value": "secret words", "status": 0}, "expect": {"ok": {"text": "secret words"}}},
    {"name": "keychain.add behind the person's presence: added", "request": "keychain.add.presence", "capability": "keychain.add",
     "args": {"key": "seed", "service": "org.example.app", "access": "userPresence", "hex": "01"},
     "reply": {"ok": true, "status": 0, "exists": false, "access": "userPresence"}, "expect": {"ok": "added"}},
    {"name": "keychain.add behind the person's presence: no passcode on a device, nothing stored", "request": "keychain.add.presence",
     "reply": {"ok": false, "status": -25293, "exists": false}, "expect": {"error": {"kind": "denied", "name": "status -25293", "code": -25293}}},
    {"name": "keychain.add behind the person's presence and synchronizable: refused", "request": "keychain.add.presence.sync", "capability": "keychain.add",
     "args": {"key": "seed", "service": "org.example.app", "synchronizable": true, "access": "userPresence", "hex": "01"},
     "reply": {"ok": false, "status": -50, "exists": false}, "expect": {"error": {"kind": "failed", "name": "status -50", "code": -50}}},
    {"name": "keychain.addApplied: added behind the person's presence", "request": "keychain.addApplied", "capability": "keychain.add",
     "args": {"key": "seed", "service": "org.example.app", "access": "userPresence", "hex": "01"},
     "reply": {"ok": true, "status": 0, "exists": false, "access": "userPresence"}, "expect": {"ok": {"added": "added", "access": "userPresence"}}},
    {"name": "keychain.addApplied: a simulator without a passcode stored it unlocked", "request": "keychain.addApplied",
     "reply": {"ok": true, "status": 0, "exists": false, "access": "unlocked"}, "expect": {"ok": {"added": "added", "access": "unlocked"}}},
    {"name": "keychain.addApplied: a shell that says nothing applied nothing", "request": "keychain.addApplied",
     "reply": {"ok": true, "status": 0, "exists": false}, "expect": {"ok": {"added": "added", "access": "unlocked"}}},
    {"name": "keychain.addApplied: already exists, untouched", "request": "keychain.addApplied", "reply": {"ok": false, "status": -25299, "exists": true},
     "expect": {"ok": {"added": "alreadyExists", "access": "userPresence"}}},
    {"name": "keychain.addApplied: an access the client does not know", "request": "keychain.addApplied",
     "reply": {"ok": true, "status": 0, "exists": false, "access": "biometryCurrentSet"}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "keychain.set behind the person's presence: refused, set makes no such item", "request": "keychain.set.presence", "capability": "keychain.set",
     "args": {"key": "seed", "service": "org.example.app", "access": "userPresence", "hex": "00ff"},
     "reply": {"ok": false, "status": -50}, "expect": {"error": {"kind": "failed", "name": "status -50", "code": -50}}},
    {"name": "keychain.set over an item behind the person's presence: refused, the item as it was", "request": "keychain.set",
     "reply": {"ok": false, "status": -25308}, "expect": {"error": {"kind": "failed", "name": "status -25308", "code": -25308}}},
    {"name": "keychain.protect: upgraded in place", "request": "keychain.protect", "capability": "keychain.protect",
     "args": {"key": "wallet", "service": "org.example.app", "access": "userPresence"},
     "reply": {"ok": true, "status": 0, "changed": true, "access": "userPresence"}, "expect": {"ok": {"changed": true}}},
    {"name": "keychain.protect: already behind it", "request": "keychain.protect", "reply": {"ok": true, "status": 0, "changed": false, "access": "userPresence"},
     "expect": {"ok": {"changed": false}}},
    {"name": "keychain.protect: a simulator without a passcode left it as it was", "request": "keychain.protect",
     "reply": {"ok": true, "status": 0, "changed": false, "access": "unlocked"}, "expect": {"ok": {"changed": false}}},
    {"name": "keychain.protect: no such item", "request": "keychain.protect", "reply": {"ok": false, "status": -25300, "changed": false},
     "expect": {"error": {"kind": "failed", "name": "status -25300", "code": -25300}}},
    {"name": "keychain.protect: no passcode on a device, the item as it was", "request": "keychain.protect", "reply": {"ok": false, "status": -25293, "changed": false},
     "expect": {"error": {"kind": "denied", "name": "status -25293", "code": -25293}}},
    {"name": "keychain.protect: a synchronizable item", "request": "keychain.protect", "reply": {"ok": false, "status": -50, "changed": false},
     "expect": {"error": {"kind": "failed", "name": "status -50", "code": -50}}},
    {"name": "keychain.protect: ok contradicts status", "request": "keychain.protect", "reply": {"ok": true, "status": -25293, "changed": true}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "keychain.protect: changed missing (never a default)", "request": "keychain.protect", "reply": {"ok": true, "status": 0}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "keychain.protect: an older shell", "request": "keychain.protect", "reply": {"error": "unknown capability keychain.protect"},
     "expect": {"error": {"kind": "unsupported", "name": "unknownCapability"}}},
    {"name": "keychain.attributes: behind the person's presence", "request": "keychain.attributes", "capability": "keychain.attributes",
     "args": {"key": "wallet", "service": "org.example.app"},
     "reply": {"status": 0, "accessible": "whenUnlockedThisDeviceOnly", "userPresence": true, "synchronizable": false},
     "expect": {"ok": {"accessible": "whenUnlockedThisDeviceOnly", "userPresence": true, "synchronizable": false}}},
    {"name": "keychain.attributes: an iCloud Keychain item", "request": "keychain.attributes",
     "reply": {"status": 0, "accessible": "whenUnlocked", "userPresence": false, "synchronizable": true},
     "expect": {"ok": {"accessible": "whenUnlocked", "userPresence": false, "synchronizable": true}}},
    {"name": "keychain.attributes: the system names no class", "request": "keychain.attributes",
     "reply": {"status": 0, "accessible": null, "userPresence": true, "synchronizable": false},
     "expect": {"ok": {"accessible": null, "userPresence": true, "synchronizable": false}}},
    {"name": "keychain.attributes: no such item", "request": "keychain.attributes",
     "reply": {"status": -25300, "accessible": null, "userPresence": false, "synchronizable": false}, "expect": {"ok": null}},
    {"name": "keychain.attributes: no keychain access group (ad-hoc Catalyst)", "request": "keychain.attributes",
     "reply": {"status": -34018, "accessible": null, "userPresence": false, "synchronizable": false},
     "expect": {"error": {"kind": "unsupported", "name": "status -34018", "code": -34018}}},
    {"name": "keychain.attributes: userPresence missing (never a default)", "request": "keychain.attributes",
     "reply": {"status": 0, "accessible": "whenUnlocked", "synchronizable": false}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "keychain.attributes: no status", "request": "keychain.attributes", "reply": {"userPresence": true, "synchronizable": false}, "expect": {"error": {"kind": "malformed"}}},

    {"name": "http.get: a response", "request": "http.get", "capability": "http.get",
     "args": {"url": "https://example.com/a", "maxBytes": 100, "timeout": 5, "accept": "application/json", "socks": {"host": "127.0.0.1", "port": 9050}},
     "reply": {"status": 200, "body": "6869"}, "expect": {"ok": {"status": 200, "body": "6869"}}},
    {"name": "http.get: a 404 is a response", "request": "http.get.plain", "capability": "http.get", "args": {"url": "https://example.com/", "maxBytes": 1000000},
     "reply": {"status": 404, "body": ""}, "expect": {"ok": {"status": 404, "body": ""}}},
    {"name": "http.get: too large", "request": "http.get.plain", "reply": {"error": "tooLarge"}, "expect": {"error": {"kind": "failed", "name": "tooLarge"}}},
    {"name": "http.get: bad proxy", "request": "http.get.plain", "reply": {"error": "bad-proxy"}, "expect": {"error": {"kind": "failed", "name": "bad-proxy"}}},
    {"name": "http.get: no response", "request": "http.get.plain", "reply": {"error": "response"}, "expect": {"error": {"kind": "failed", "name": "response"}}},
    {"name": "http.get: cancelled", "request": "http.get.plain", "reply": {"error": "cancelled", "code": -999, "domain": "NSURLErrorDomain"},
     "expect": {"error": {"kind": "cancelled", "name": "system", "code": -999, "domain": "NSURLErrorDomain"}}},
    {"name": "http.get: offline", "request": "http.get.plain", "reply": {"error": "The Internet connection appears to be offline.", "code": -1009, "domain": "NSURLErrorDomain"},
     "expect": {"error": {"kind": "failed", "name": "system", "code": -1009, "domain": "NSURLErrorDomain"}}},
    {"name": "http.get: a system error from an older shell keeps its text", "request": "http.get.plain", "reply": {"error": "Could not connect to the server."},
     "expect": {"error": {"kind": "failed", "name": "Could not connect to the server."}}},
    {"name": "http.get: body not hex", "request": "http.get.plain", "reply": {"status": 200, "body": "xyz"}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "http.get: no status", "request": "http.get.plain", "reply": {"body": "00"}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "http.get: negative status", "request": "http.get.plain", "reply": {"status": -1, "body": ""}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "http.request: POST with JSON bytes", "request": "http.request", "capability": "http.request",
     "args": {"url": "https://example.com/api/login", "maxBytes": 1000000, "method": "POST", "headers": {"Content-Type": "application/json"}, "body": "7b7d"},
     "reply": {"status": 200, "body": "7b7d"}, "expect": {"ok": {"status": 200, "body": "7b7d"}}},
    {"name": "http.request: bad body", "request": "http.request", "reply": {"error": "bad-body"}, "expect": {"error": {"kind": "failed", "name": "bad-body"}}},

    {"name": "cloudkit.account: available", "request": "cloudkit.account", "capability": "cloudkit.account", "args": {"container": "iCloud.org.example.app"},
     "reply": {"status": "available", "user": "_abc"}, "expect": {"ok": {"status": "available", "user": "_abc"}}},
    {"name": "cloudkit.account: no account", "request": "cloudkit.account", "reply": {"status": "noAccount", "user": null},
     "expect": {"ok": {"status": "noAccount", "user": null}}},
    {"name": "cloudkit.account: available without a user", "request": "cloudkit.account", "reply": {"status": "available"}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "cloudkit.account: an unknown status", "request": "cloudkit.account", "reply": {"status": "maybe", "user": null}, "expect": {"error": {"kind": "malformed"}}},
    {"name": "cloudkit.account: no entitlement", "request": "cloudkit.account", "reply": {"error": "missingEntitlement", "detail": "no CloudKit in the com.apple.developer.icloud-services entitlement"},
     "expect": {"error": {"kind": "unsupported", "name": "missingEntitlement"}}},
    {"name": "cloudkit.account: not signed in", "request": "cloudkit.account", "reply": {"error": "notAuthenticated", "code": 9, "detail": "?"},
     "expect": {"error": {"kind": "denied", "name": "notAuthenticated", "code": 9}}},
    {"name": "cloudkit.query: records", "request": "cloudkit.query", "capability": "cloudkit.query",
     "args": {"type": "Note", "equals": {"network": "signet"}, "sortBy": "savedAt", "ascending": false, "keys": ["network", "savedAt"], "limit": 500},
     "reply": {"records": [{"name": "n1", "type": "Note", "fields": {"network": "signet", "savedAt": {"date": 1.5}, "blob": {"hex": "00"}, "file": {"asset": true}, "parent": {"ref": "n0"}, "tags": ["a", 2]}, "modified": 2.5, "tag": "t1"}], "more": false},
     "expect": {"ok": {"records": [{"name": "n1", "type": "Note", "modified": 2.5, "tag": "t1",
       "fields": {"network": "signet", "savedAt": {"date": 1.5}, "blob": {"hex": "00"}, "file": {"asset": true}, "parent": {"ref": "n0"}, "tags": ["a", 2]}}], "more": false}}},
    {"name": "cloudkit.query: a field of unknown kind", "request": "cloudkit.query", "reply": {"records": [{"name": "n", "type": "Note", "fields": {"x": {"location": [1, 2]}}}], "more": false},
     "expect": {"error": {"kind": "malformed"}}},
    {"name": "cloudkit.query: no records", "request": "cloudkit.query", "reply": {"more": false}, "expect": {"error": {"kind": "malformed"}}},
